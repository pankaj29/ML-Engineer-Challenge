# =============================================================================
# Environment configuration.
#
# Copy this to `.env` and edit. `.env` is gitignored and must never be
# committed: it is where real secrets live.
#
#   cp .env.example .env
#
# Every value here has a safe default in api/config.py, so the stack starts
# with an empty .env for local development. Staging and production refuse to
# start without a real JWT_SECRET - see the validator in api/config.py.
# =============================================================================

# --- Environment -------------------------------------------------------------
# local | test | staging | production
ENVIRONMENT=local
DEBUG=false
LOG_LEVEL=INFO
# json for production (machine-readable), console for local development
LOG_FORMAT=console

# --- Ports (host side) -------------------------------------------------------
GATEWAY_PORT=80
API_PORT=8000
REDIS_PORT=6379
POSTGRES_PORT=5432
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# --- Security ----------------------------------------------------------------
AUTH_ENABLED=true

# Comma-separated `key:tier` pairs. Tiers: free, basic, pro, enterprise.
# REPLACE THESE before any deployment that is reachable by anyone else.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEYS=dev-key-free:free,dev-key-pro:pro,dev-key-ent:enterprise

# JWT signing secret. MUST be at least 32 characters in staging/production;
# the application refuses to start otherwise.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRY_MINUTES=60

# Comma-separated allowed origins, or * for any.
CORS_ORIGINS=*

# --- Database ----------------------------------------------------------------
POSTGRES_USER=mluser
POSTGRES_PASSWORD=mlpass
POSTGRES_DB=mldb
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# --- Cache -------------------------------------------------------------------
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600
REDIS_MAXMEMORY=512mb

# --- Rate limiting (requests per minute, per API key) ------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_FREE_RPM=10
RATE_LIMIT_BASIC_RPM=60
RATE_LIMIT_PRO_RPM=300
RATE_LIMIT_ENTERPRISE_RPM=3000
# Burst allowance as a multiple of the per-minute rate.
RATE_LIMIT_BURST_MULTIPLIER=1.5

# --- Models ------------------------------------------------------------------
# onnx | onnx_int8 | torch | tensorrt
#
# `onnx` (float32) is the default on purpose. INT8 is ~4x smaller but measured
# SLOWER on CPUs without INT8 acceleration - see benchmarks/reports/BENCHMARKS.md.
# Switch to onnx_int8 only where memory matters more than latency, or on
# hardware you have benchmarked yourself.
PREFERRED_RUNTIME=onnx

# auto | cpu | cuda
DEVICE=auto

# Load models at startup rather than on the first request.
EAGER_MODEL_LOAD=true

# Cap on simultaneous inferences. Roughly 1-2 per available CPU core: higher
# values make everything slower rather than faster.
MAX_CONCURRENT_INFERENCES=4
INFERENCE_TIMEOUT_SECONDS=30

# --- Upload limits -----------------------------------------------------------
MAX_IMAGE_BYTES=10485760
MAX_IMAGE_PIXELS=50000000
MAX_BATCH_SIZE=64
ALLOWED_IMAGE_FORMATS=JPEG,PNG,WEBP,BMP

# --- Observability -----------------------------------------------------------
METRICS_ENABLED=true
# Requests slower than this are logged at WARNING as an early alert.
SLOW_REQUEST_THRESHOLD_SECONDS=1.0
PROMETHEUS_RETENTION=15d
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# --- Resource limits ---------------------------------------------------------
API_CPU_LIMIT=2.0
API_MEMORY_LIMIT=4G
WORKER_CPU_LIMIT=2.0
WORKER_MEMORY_LIMIT=4G
REDIS_MEMORY_LIMIT=768M
POSTGRES_MEMORY_LIMIT=1G
