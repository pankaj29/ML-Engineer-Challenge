# --- Datasets --------------------------------------------------------------
# The dataset stays out: 100k files and ~240 MB that download_datasets.py can
# reproduce exactly. Model artifacts DO go in, via Git LFS (.gitattributes),
# because they cannot be reproduced without a GPU session.
data/
!data/.gitkeep

# --- Model binaries --------------------------------------------------------
# models/artifacts/ is tracked through Git LFS. These patterns still exclude
# binaries written ANYWHERE ELSE - checkpoints dropped in the repo root during
# an experiment, say - which is what they were guarding against.
/*.pt
/*.pth
/*.onnx
/*.engine
*.plan
*.index
*.faiss
# ONNX external-data sidecars, written by torch's dynamo exporter
*.data

# --- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.Python
build/
dist/

# --- Test & tooling artefacts ---------------------------------------------
.pytest_cache/
.coverage
.coverage.*
coverage.xml
coverage.json
htmlcov/
.mypy_cache/
.ruff_cache/
.benchmarks/

# --- Secrets & local config ------------------------------------------------
.env
.env.*
!.env.example
secrets/

# --- Runtime output --------------------------------------------------------
logs/
*.log
runs/
tensorboard/

# --- OS / editor -----------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/

# --- Build artifacts -------------------------------------------------------
# Regenerate with: python scripts/package_for_colab.py
ml-engineer-challenge-colab.zip
gpu_results.zip
